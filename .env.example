# NEXUS OSINT — example environment file (no real secrets)
# Copy this file to .env and fill in real values before running the backend.
# Never commit .env — it is gitignored.

APP_NAME=NEXUS OSINT
APP_ENV=development
APP_DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_PORT=3000

# Database (SQLite by default in Phase 1; Postgres in later phases)
DATABASE_URL=sqlite:///./nexus.db

# Secret placeholders — replace with real values in production
SECRET_KEY=change-me-in-production
API_KEY=env:API_KEY
