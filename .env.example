# NEXUS OSINT — example environment file (no real secrets)
# Copy this file to .env and fill in real values before running the backend.
# Never commit .env — it is gitignored.

APP_NAME=NEXUS OSINT
APP_ENV=development
APP_DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_PORT=3000

# Database (SQLite by default in Phase 1; Postgres in later phases)
DATABASE_URL=sqlite:///./nexus.db

# Secret placeholders — replace with real values in production
SECRET_KEY=change-me-in-production
API_KEY=env:API_KEY

# --- التشغيل المحلي بدون حاويات (scripts/dev.sh و scripts/dev.ps1) ---
# حزمة الخلفية جذرها ``app`` داخل backend/، لذا منفذ ASGI هو app.main:app
# (لا backend.app.main:app). سكربتات التطوير و Dockerfile يقرؤون المفاتيح التالية.
APP_IMPORT=app.main:app
# بادئة مسارات REST كما تُعرّفها الخلفية (Settings.api_v1_prefix).
API_V1_PREFIX=/api/v1

# --- التشغيل بالحاويات (docker compose) ---
# منفذ الخلفية على المضيف (المنفذ داخل الحاوية مثبّت على 8000 ليطابق nginx.conf).
BACKEND_HOST_PORT=8000
# مسار SQLite داخل حاوية الخلفية: يجب أن يقع داخل الـ volume الدائم
# nexus-osint-data حتى لا تضيع البيانات عند docker compose down.
# NEXUS_SQLITE_URL=sqlite:////app/data/aatm.db
