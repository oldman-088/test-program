# NEXUS OSINT — example environment file (no real secrets)
# Copy this file to .env and fill in real values before running the backend.
# Never commit .env — it is gitignored.

APP_NAME=NEXUS OSINT
APP_ENV=development
APP_DEBUG=true

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

FRONTEND_PORT=3000

# Database (SQLite by default in Phase 1; Postgres in later phases)
DATABASE_URL=sqlite:///./nexus.db

# Secret placeholders — replace with real values in production
SECRET_KEY=change-me-in-production
API_KEY=env:API_KEY

# --- Backend core additions (FastAPI app, backend/app) ---
# The FastAPI core reads these via pydantic-settings (all optional; safe defaults,
# boot requires no secret and no network). APP_ENV / APP_DEBUG above are the
# Phase 1 setup-script conventions; the backend core itself reads DEBUG.

# Comma-separated CORS origins allowed for the dashboard frontend.
FRONTEND_ORIGIN=http://localhost:3000,http://localhost:5173

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL (logs are structured JSON).
LOG_LEVEL=INFO

# Process version surfaced by GET /api/health.
APP_VERSION=0.1.0

# Backend-core debug switch (true -> environment "development" in /api/health).
DEBUG=true

# Optional secret for signed tokens/sessions in later phases. Leave unset to boot.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER put a real value here or in any committed file.
# SECRET_KEY=
