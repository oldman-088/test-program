# Copy to .env (never commit .env) and adjust as needed.

# SQLite (default) — or point at PostgreSQL, e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/scores
DATABASE_URL=sqlite:///./scores.db

# Comma-separated list of allowed browser origins
# (a JSON array string is also accepted: CORS_ORIGINS='["http://localhost:5173"]')
CORS_ORIGINS=http://localhost:5173
