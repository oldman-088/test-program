# Copy to .env and adjust as needed. All values are optional.

# SQLite by default; PostgreSQL is supported too, e.g.:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memory_game
DATABASE_URL=sqlite:///./scores.db

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Create missing tables on startup (handy for local dev; use Alembic in prod).
AUTO_CREATE_SCHEMA=true

# Optional: path to a built frontend bundle served by the API.
# FRONTEND_DIST=../frontend/dist
