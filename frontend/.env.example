# NEXUS OSINT frontend — example environment (no real secrets)
# Copy to .env.local for local overrides. Never commit .env.local.
#
# Base URL for the backend API. Leave empty to use relative /api/v1/... URLs
# (Vite dev proxy forwards them to the backend). Set to an absolute origin
# only when the frontend is served from a different host than the backend.
VITE_API_BASE_URL=

# API key for the backend contract (docs/API.md, main). Required by every
# /api/v1 endpoint except the public GET /api/v1/health and
# GET /api/v1/health/ready, which are called without this header.
# Leave empty for local development against a backend without auth.
VITE_API_KEY=
