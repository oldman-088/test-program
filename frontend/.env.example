# NEXUS OSINT frontend — example environment (no real secrets)
# Copy to .env.local for local overrides. Never commit .env.local.
#
# Base URL for the backend API. Leave empty to use relative /api/... URLs
# (Vite dev proxy forwards them to the backend). Set to an absolute origin
# only when the frontend is served from a different host than the backend.
VITE_API_BASE_URL=
